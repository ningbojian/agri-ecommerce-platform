# Copy/export these before starting the Spring Boot services.
# Windows PowerShell: $env:XCFP_DB_PASSWORD="your-password"
# Windows cmd:        set XCFP_DB_PASSWORD=your-password
# Git Bash:           export XCFP_DB_PASSWORD="your-password"

# MySQL account shared by the three services
XCFP_DB_USER=root
XCFP_DB_PASSWORD=change-me

# Optional: override the default local database URLs (127.0.0.1 avoids IPv6 issues on Windows)
XCFP_PRO_DB_URL=jdbc:mysql://127.0.0.1:3306/xcfp_pro?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
XCFP_SUP_DB_URL=jdbc:mysql://127.0.0.1:3306/xcfp_sup?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
XCFP_USER_DB_URL=jdbc:mysql://127.0.0.1:3306/xcfp_user?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# Shared by all three services. Change both values outside local development.
XCFP_JWT_SECRET=xcfp-local-dev-secret-please-change-0123456789
XCFP_INTERNAL_TOKEN=xcfp-local-internal-token

# service_user -> service_proinfo internal stock API
XCFP_PRODUCT_SERVICE_URL=http://127.0.0.1:8201

# Optional: set to false if Springfox fails to start on your JDK/Spring Boot combination
XCFP_SWAGGER_ENABLED=true
