<!--pages/proinfo/proinfo.wxml-->
<view wx:if="{{loading}}" class="state">加载中...</view>
<view wx:elif="{{error}}" class="state">{{error}}</view>
<view wx:else>
  <image class="banner" src="{{pro.picurl}}" mode="aspectFill"></image>

  <view class="detail">
    <text class="title">{{pro.proname}}</text>
    <view class="price-row">
      <text class="price">￥{{pro.price}}</text>
      <text class="unit">/ {{pro.unit || '件'}}</text>
    </view>
    <view class="tags">
      <text>库存 {{pro.stock}}</text>
      <text>已售 {{pro.sales || 0}}</text>
      <text>{{pro.delivery}}</text>
    </view>
    <view class="desc">{{pro.descript}}</view>

    <view class="supname">店铺：{{pro.supname}}</view>

    <view class="qty-row">
      <text>购买数量</text>
      <view class="stepper">
        <text class="{{minusStatus}}" bindtap="bindMinus">-</text>
        <input type="number" bindinput="bindManual" value="{{num}}" />
        <text class="normal" bindtap="bindPlus">+</text>
      </view>
    </view>
  </view>

  <!-- 底部悬浮栏 -->
  <view class="detail-nav">
    <button class="button-red" bindtap="pay">立即购买</button>
  </view>
</view>
