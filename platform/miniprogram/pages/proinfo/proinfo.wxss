page {
  background: #f5f1e8;
  padding-bottom: 120rpx;
}

.banner {
  width: 100%;
  height: 520rpx;
  background: #eee;
}

.detail {
  margin: 20rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}

.detail .title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #222;
}

.detail .price-row {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}

.detail .price {
  color: #e53935;
  font-size: 44rpx;
}

.detail .unit {
  margin-left: 8rpx;
  color: #999;
  font-size: 24rpx;
}

.detail .tags {
  display: flex;
  margin-top: 16rpx;
  color: #888;
  font-size: 24rpx;
}

.detail .tags text {
  margin-right: 24rpx;
}

.detail .desc {
  margin-top: 24rpx;
  color: #555;
  font-size: 28rpx;
  line-height: 1.6;
}

.detail .supname {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  color: #777;
  font-size: 26rpx;
}

.qty-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
}

.stepper {
  display: flex;
  align-items: center;
  width: 200rpx;
  height: 60rpx;
  border: 1rpx solid #bbb;
  border-radius: 8rpx;
  overflow: hidden;
}

.stepper text {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 34rpx;
  background: #f2f2f2;
}

.stepper input {
  flex: 1;
  height: 60rpx;
  text-align: center;
  font-size: 26rpx;
}

.stepper .disabled {
  color: #ccc;
}

.stepper .normal {
  color: #333;
}

.detail-nav {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  background: #ffff99;
  padding: 14rpx 24rpx;
}

.button-red {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: #e53935;
  color: #fff;
  font-size: 32rpx;
  border-radius: 42rpx;
}

.state {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
}
