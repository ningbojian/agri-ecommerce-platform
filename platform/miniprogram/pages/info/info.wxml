<!--pages/info/info.wxml-->
<view class="page">
  <view class="header">
    <view class="header-title">助农资讯</view>
    <view class="header-sub">了解农产品上行、冷链与平台规则</view>
  </view>

  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state">
    <text>{{error}}</text>
    <button class="retry" size="mini" bindtap="retry">重试</button>
  </view>
  <view wx:elif="{{!list.length}}" class="state">暂无资讯</view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="article-card"
    data-id="{{item.id}}"
    bindtap="openDetail"
  >
    <image class="cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load="true"></image>
    <view class="content">
      <view class="title">{{item.title}}</view>
      <view class="summary">{{item.summary}}</view>
      <view class="meta">
        <text>{{item.author}}</text>
        <text>{{item.publishTime}}</text>
      </view>
    </view>
  </view>
</view>
