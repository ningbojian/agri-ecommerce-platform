page {
  background: #fff;
}

.page {
  padding: 30rpx;
}

.state {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #222;
  line-height: 1.4;
}

.meta {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  color: #999;
  font-size: 22rpx;
}

.cover {
  width: 100%;
  height: 360rpx;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: #eee;
}

.content {
  display: block;
  margin-top: 28rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.9;
  white-space: pre-wrap;
}
