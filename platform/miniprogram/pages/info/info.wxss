page {
  background: #f5f1e8;
}

.page {
  min-height: 100vh;
  padding-bottom: 30rpx;
}

.header {
  background: #ffff99;
  padding: 40rpx 30rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #33402f;
}

.header-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6d6a56;
}

.article-card {
  margin: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 300rpx;
  background: #eee;
}

.content {
  padding: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.summary {
  margin-top: 12rpx;
  color: #666;
  font-size: 25rpx;
  line-height: 1.6;
}

.meta {
  margin-top: 16rpx;
  display: flex;
  justify-content: space-between;
  color: #aaa;
  font-size: 21rpx;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.retry {
  margin-top: 16rpx;
  background: #2f7b27;
  color: #fff;
}
