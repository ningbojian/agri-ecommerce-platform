page {
  background: #f5f1e8;
}

.wrap {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3f4438;
  margin-bottom: 24rpx;
}

.input {
  width: 100%;
  height: 240rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.contact {
  margin-top: 16rpx;
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.submit {
  margin-top: 24rpx;
  background: #9b6f45;
  color: #fff;
  border-radius: 10rpx;
  font-size: 30rpx;
}

.history-title {
  margin-top: 44rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #3f4438;
}

.empty {
  padding: 30rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.feedback-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.feedback-head {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
}

.feedback-head .status {
  color: #d98b1f;
}

.feedback-head .status.replied {
  color: #2f7b27;
}

.feedback-content {
  margin-top: 12rpx;
  font-size: 27rpx;
  color: #333;
  line-height: 1.6;
}

.reply {
  margin-top: 14rpx;
  padding: 14rpx;
  background: #f4f8f2;
  border-radius: 8rpx;
  font-size: 25rpx;
  color: #3f5f3a;
  line-height: 1.6;
}

.reply-label {
  font-weight: 600;
}
