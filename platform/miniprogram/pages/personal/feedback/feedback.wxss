.wrap { padding: 40rpx; background: #f7f4ec; min-height: 100vh; box-sizing: border-box; }
.title { font-size: 40rpx; font-weight: bold; color: #3f4438; margin-bottom: 30rpx; }
.input { width: 100%; height: 260rpx; padding: 20rpx; background: #fff; border-radius: 12rpx; box-sizing: border-box; }
.submit { margin-top: 30rpx; background: #9b6f45; color: #fff; border-radius: 10rpx; }
.hint { margin-top: 24rpx; color: #7c7765; font-size: 24rpx; line-height: 1.6; }
