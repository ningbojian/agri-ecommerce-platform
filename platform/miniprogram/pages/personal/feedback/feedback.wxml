<view class="wrap">
  <view class="title">意见反馈</view>

  <textarea
    class="input"
    maxlength="500"
    value="{{content}}"
    placeholder="写下你的意见或建议（最多 500 字）"
    bindinput="onInput"
  ></textarea>
  <input
    class="contact"
    maxlength="64"
    value="{{contact}}"
    placeholder="联系方式（选填）"
    bindinput="onContactInput"
  />
  <button class="submit" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交反馈</button>

  <view class="history-title">我的反馈</view>
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{!list.length}}" class="empty">还没有提交过反馈</view>
  <view wx:for="{{list}}" wx:key="id" class="feedback-item">
    <view class="feedback-head">
      <text class="time">{{item.createTime}}</text>
      <text class="status {{item.status === 1 ? 'replied' : ''}}">{{item.statusText}}</text>
    </view>
    <view class="feedback-content">{{item.content}}</view>
    <view wx:if="{{item.reply}}" class="reply">
      <text class="reply-label">平台回复：</text>
      <text>{{item.reply}}</text>
    </view>
  </view>
</view>
