<!--pages/personal/personal.wxml-->
<view class="personalContainer">
  <view class="user-section">
    <image class="bg" src="/static/bgImg.jpg"></image>
    <view class="user-info-box" bindtap="toLogin">
      <view class="info-pic">
        <image class="portrait" src="{{userInfo.avatar || '/static/missing-face.png'}}"></image>
      </view>
      <view class="info-box">
        <block wx:if="{{loggedIn}}">
          <text class="username">{{userInfo.nickname || userInfo.tel}}</text>
          <text class="sub">{{userInfo.tel}}</text>
        </block>
        <block wx:else>
          <text class="username">游客</text>
          <text class="sub">点击登录</text>
        </block>
      </view>
    </view>

    <view class="vip-card-box">
      <image class="card-bg" src="/static/vip-card-bg.png" mode=""></image>
      <view class="b-btn">乡村振兴</view>
      <view class="tit">
        <text class="iconfont icon-huiyuan-"></text>
        乡村探宝
      </view>
      <text class="e-m">rural revitalization</text>
      <text class="e-b">我和我的家乡</text>
    </view>
  </view>

  <view class="cover-container">
    <image class="arc" src="/static/arc.png"></image>

    <!-- 订单入口 -->
    <view class="nav-section">
      <view class="nav-item" hover-class="common-hover" hover-stay-time="50" data-state="" bindtap="goOrders">
        <text class="iconfont icon-dingdan"></text>
        <text>全部</text>
      </view>
      <view class="nav-item" hover-class="common-hover" hover-stay-time="50" data-state="created" bindtap="goOrders">
        <text class="iconfont icon-dingdandaifukuan"></text>
        <text>待付款</text>
      </view>
      <view class="nav-item" hover-class="common-hover" hover-stay-time="50" data-state="paid" bindtap="goOrders">
        <text class="iconfont icon-daifahuodingdan"></text>
        <text>待发货</text>
      </view>
      <view class="nav-item" hover-class="common-hover" hover-stay-time="50" data-state="shipped" bindtap="goOrders">
        <text class="iconfont icon-daifahuodingdan"></text>
        <text>待收货</text>
      </view>
      <view class="nav-item" hover-class="common-hover" hover-stay-time="50" data-state="completed" bindtap="goOrders">
        <text class="iconfont icon-tuihuodingdan"></text>
        <text>已完成</text>
      </view>
    </view>

    <!-- 个人中心列表 -->
    <view class="personalContent">
      <view class="cardList">
        <view class="card-item" bindtap="goAddress">
          <text class="title">收货地址</text>
          <text class="more">></text>
        </view>
        <view class="card-item" bindtap="goFeedback">
          <text class="title">意见反馈</text>
          <text class="more">></text>
        </view>
        <navigator url="about/about">
          <view class="card-item">
            <text class="title">关于</text>
            <text class="more">></text>
          </view>
        </navigator>
        <view wx:if="{{loggedIn}}" class="card-item logout" bindtap="logout">
          <text class="title">退出登录</text>
          <text class="more">></text>
        </view>
      </view>
    </view>
  </view>
</view>
