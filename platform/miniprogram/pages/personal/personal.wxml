<!--pages/personal/personal.wxml-->
<view class="personalContainer">
  <view class="user-section">
    <image class="bg"  wx:if="{{!userInfo.tel}}" src="/static/bgImg.jpg"></image>
    <open-data class="bg" wx:if="{{userInfo.tel}}" type="userAvatarUrl" ></open-data>
    <view class="user-info-box" bindtap="toLogin">
      <view class="info-pic">
        <image class="portrait"  wx:if="{{!userInfo.tel}}" src='/static/missing-face.png'></image>
        <open-data class="portrait" wx:if="{{userInfo.tel}}" type="userAvatarUrl" ></open-data>
      </view>
      <view class="info-box">
        <text class="username" wx:if="{{!userInfo.tel}}">游客</text>
        <open-data class="username" wx:if="{{userInfo.tel}}" type="userNickName" ></open-data>
      </view>
    </view>

    <view class="vip-card-box">
      <image class="card-bg" src="/static/vip-card-bg.png" mode=""></image>
      <view class="b-btn">
        美丽中国
      </view>
      <view class="tit">
        <!-- 会员图标-->
        <text class="iconfont icon-huiyuan-"></text>
        乡村振兴
      </view>
      <text class="e-m">rural revitalization</text>
      <text class="e-b">我和我的家乡</text>
    </view>
  </view>

  <view class="cover-container" bindtouchstart="handleTouchStart"
    bindtouchmove="handleTouchMove"
    bindtouchend="handleTouchEnd"
    style="transform:{{coverTransform}};transition:{{coverTransition}}">
    <image class="arc" src="/static/arc.png"></image>
    <!-- 个人中心导航 -->
    <view class="nav-section">
      <view class="nav-item" hover-class="common-hover" hover-stay-time="50" id="1" catchtap="click1">
        <text class="iconfont icon-dingdan"></text>
        <text>全部订单</text>
      </view>
      <view class="nav-item" hover-class="common-hover" hover-stay-time="50" id="2" catchtap="click2">
        <text class="iconfont icon-dingdandaifukuan"></text>
        <text>待发货</text>
      </view>
      <view class="nav-item" hover-class="common-hover" hover-stay-time="50" id="3" catchtap="click3">
        <text class="iconfont icon-daifahuodingdan"></text>
        <text>待收货</text>
      </view>
      <view class="nav-item" hover-class="common-hover" hover-stay-time="50" id="4" catchtap="click4">
        <text class="iconfont icon-tuihuodingdan"></text>
        <text>退款/退货</text>
      </view>
    </view>

    <!-- 个人中心列表 -->
    <view class="personalContent">

      <view class="cardList">
        <navigator url="address/address">
          <view class="card-item">
            <text class="title">收货地址</text>
            <text class="more"> > </text>
          </view>
        </navigator>

        <navigator url="about/about">
          <view class="card-item">
            <text class="title">关于</text>
            <text class="more"> > </text>
          </view>
        </navigator>

        <navigator url="feedback/feedback">
          <view class="card-item">
            <text class="title">意见反馈</text>
            <text class="more"> > </text>
          </view>
        </navigator>

      </view>
    </view>
  </view>

</view>