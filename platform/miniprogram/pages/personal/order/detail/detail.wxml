<view wx:if="{{loading}}" class="state">加载中...</view>
<view wx:elif="{{error}}" class="state">{{error}}</view>
<view wx:else class="page">
  <view class="status-card">
    <view class="status-text status-{{order.state}}">{{order.stateText}}</view>
    <view class="order-no">订单号：{{order.orderid}}</view>
  </view>

  <view class="card">
    <view class="card-title">收货信息</view>
    <view class="row"><text class="label">收货人</text><text>{{order.receiverName}}</text></view>
    <view class="row"><text class="label">联系电话</text><text>{{order.receiverTel}}</text></view>
    <view class="row"><text class="label">收货地址</text><text class="value">{{order.receiverAddress}}</text></view>
    <view class="row" wx:if="{{order.express}}"><text class="label">快递单号</text><text>{{order.express}}</text></view>
  </view>

  <view class="card">
    <view class="card-title">商品信息</view>
    <view class="product">
      <image class="product-img" src="{{order.picurl}}" mode="aspectFill"></image>
      <view class="product-info">
        <view class="product-title">{{order.proname}}</view>
        <view class="sub">商户：{{order.supname}}</view>
        <view class="sub">单价：￥{{order.price}}</view>
        <view class="sub">数量：{{order.num}}</view>
      </view>
    </view>
    <view class="row total"><text class="label">实付金额</text><text class="amount">￥{{order.pay}}</text></view>
  </view>

  <view class="card">
    <view class="card-title">订单进度</view>
    <view class="row"><text class="label">下单时间</text><text>{{order.createTime}}</text></view>
    <view class="row" wx:if="{{order.payTime}}"><text class="label">支付时间</text><text>{{order.payTime}}</text></view>
    <view class="row" wx:if="{{order.shipTime}}"><text class="label">发货时间</text><text>{{order.shipTime}}</text></view>
    <view class="row" wx:if="{{order.completeTime}}"><text class="label">完成时间</text><text>{{order.completeTime}}</text></view>
    <view class="row" wx:if="{{order.cancelTime}}"><text class="label">取消时间</text><text>{{order.cancelTime}}</text></view>
  </view>

  <view class="footer">
    <button wx:if="{{order.state === 'created'}}" class="btn" bindtap="cancel">取消订单</button>
    <button wx:if="{{order.state === 'created'}}" class="btn primary" bindtap="pay">去支付</button>
    <button wx:if="{{order.state === 'shipped'}}" class="btn primary" bindtap="confirm">确认收货</button>
  </view>
</view>
