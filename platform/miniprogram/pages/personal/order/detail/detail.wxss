page {
  background: #f5f1e8;
}

.page {
  padding: 20rpx 20rpx 140rpx;
}

.state {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
}

.status-card {
  background: #2f7b27;
  color: #fff;
  border-radius: 16rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 20rpx;
}

.status-text {
  font-size: 38rpx;
  font-weight: 600;
}

.status-created {
  color: #ffe0e0;
}

.order-no {
  margin-top: 12rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
  font-size: 26rpx;
  color: #333;
}

.row .label {
  color: #888;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.row .value {
  text-align: right;
}

.row .amount {
  color: #e53935;
  font-size: 32rpx;
  font-weight: 600;
}

.row.total {
  margin-top: 12rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f0f0f0;
}

.product {
  display: flex;
  padding-bottom: 16rpx;
}

.product-img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}

.product-info {
  margin-left: 18rpx;
}

.product-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
}

.sub {
  margin-top: 8rpx;
  color: #888;
  font-size: 22rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  background: #ffff99;
  display: flex;
  justify-content: flex-end;
}

.btn {
  margin-left: 16rpx;
  min-width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  border-radius: 38rpx;
  background: #fff;
  color: #555;
  border: 1rpx solid #ddd;
}

.btn.primary {
  background: #2f7b27;
  color: #fff;
  border-color: #2f7b27;
}
