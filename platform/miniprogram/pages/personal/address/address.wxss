page {
  background: #f5f1e8;
}

.page {
  min-height: 100vh;
  padding: 20rpx 20rpx 140rpx;
  box-sizing: border-box;
}

.select-tip {
  padding: 12rpx 8rpx;
  color: #777;
  font-size: 26rpx;
}

.address-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.address-head {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #222;
}

.address-head .name {
  font-weight: 600;
  margin-right: 20rpx;
}

.address-head .tel {
  color: #666;
}

.address-head .default {
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #2f7b27;
  border: 1rpx solid #2f7b27;
  border-radius: 8rpx;
}

.address-text {
  margin-top: 14rpx;
  color: #555;
  font-size: 26rpx;
  line-height: 1.5;
}

.actions {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  justify-content: flex-end;
}

.action {
  margin-left: 28rpx;
  font-size: 24rpx;
  color: #666;
}

.action.primary {
  color: #2f7b27;
  font-weight: 600;
}

.action.danger {
  color: #d43c33;
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  background: #ffff99;
}

.add-btn {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: #2f7b27;
  color: #fff;
  font-size: 30rpx;
  border-radius: 42rpx;
}
