<!--pages/personal/address/address.wxml-->
<view class="page">
  <view wx:if="{{selectMode}}" class="select-tip">请选择收货地址</view>

  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state">{{error}}</view>
  <view wx:elif="{{!list.length}}" class="state">
    还没有收货地址
  </view>

  <view
    wx:for="{{list}}"
    wx:key="id"
    class="address-card"
    data-id="{{item.id}}"
    bindtap="choose"
  >
    <view class="address-head">
      <text class="name">{{item.addname}}</text>
      <text class="tel">{{item.addtel}}</text>
      <text class="default" wx:if="{{item.isDefault === 1}}">默认</text>
    </view>
    <view class="address-text">{{item.address}}</view>

    <view class="actions">
      <text
        wx:if="{{item.isDefault !== 1}}"
        class="action"
        data-id="{{item.id}}"
        catchtap="setDefault"
      >设为默认</text>
      <text class="action" data-id="{{item.id}}" catchtap="edit">编辑</text>
      <text class="action danger" data-id="{{item.id}}" catchtap="remove">删除</text>
      <text wx:if="{{selectMode}}" class="action primary" data-id="{{item.id}}" catchtap="choose">选择</text>
    </view>
  </view>

  <view class="footer">
    <button class="add-btn" bindtap="add">+ 新增收货地址</button>
  </view>
</view>
