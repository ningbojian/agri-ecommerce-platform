page {
  background: #f5f1e8;
  padding-bottom: 150rpx;
}

.state {
  padding: 120rpx 0;
  text-align: center;
  color: #999;
}

.pay-page {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.address-card {
  min-height: 120rpx;
  padding-right: 60rpx;
}

.address-head {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #222;
}

.address-head .name {
  font-weight: 600;
  margin-right: 20rpx;
}

.address-head .tel {
  color: #666;
}

.address-head .default {
  margin-left: 16rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #2f7b27;
  border: 1rpx solid #2f7b27;
  border-radius: 8rpx;
}

.address-text {
  margin-top: 12rpx;
  color: #555;
  font-size: 26rpx;
  line-height: 1.5;
}

.address-empty {
  color: #999;
  font-size: 28rpx;
  line-height: 120rpx;
}

.arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #bbb;
}

.order-card {
  display: flex;
}

.product-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background: #eee;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  margin-left: 20rpx;
}

.product-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.product-sub {
  margin-top: 10rpx;
  color: #777;
  font-size: 24rpx;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #555;
  padding: 10rpx 0;
}

.summary-row.total {
  margin-top: 10rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eee;
  color: #e53935;
  font-size: 32rpx;
  font-weight: 600;
}

.tip {
  margin: 8rpx 8rpx 0;
  color: #999;
  font-size: 22rpx;
  line-height: 1.5;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx;
  background: #ffff99;
}

.submit {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  background: #e53935;
  color: #fff;
  font-size: 32rpx;
  border-radius: 42rpx;
}
