<!--pages/index/index.wxml-->
<view class="page">
  <scroll-view class="category-bar" scroll-x="true" enable-flex="true">
    <view class="category-item {{activeCategoryId === 0 ? 'active' : ''}}" data-id="0" bindtap="selectCategory">
      全部
    </view>
    <view
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item {{activeCategoryId === item.id ? 'active' : ''}}"
      data-id="{{item.id}}"
      bindtap="selectCategory"
    >
      {{item.name}}
    </view>
  </scroll-view>

  <view wx:if="{{error}}" class="state">
    <text>{{error}}</text>
    <button class="retry" size="mini" bindtap="retry">重试</button>
  </view>

  <view class="list">
    <view class="list_item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="click">
      <view class="img">
        <image src="{{item.picurl}}" mode="aspectFill" lazy-load="true" />
      </view>
      <view class="info">
        <view class="title">{{item.proname}}</view>
        <view class="price">￥{{item.price}} / {{item.unit || '件'}}</view>
        <view class="descr">{{item.descript}}</view>
        <view class="meta">
          <text>库存 {{item.stock}}</text>
          <text>{{item.delivery}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !list.length && !error}}" class="state">暂无商品</view>
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:if="{{!loading && !hasMore && list.length}}" class="state">没有更多了</view>
</view>
