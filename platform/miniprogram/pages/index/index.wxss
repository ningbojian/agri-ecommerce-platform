/* pages/index/index.wxss */
page {
  background: #f5f1e8;
}

.page {
  min-height: 100vh;
  padding-bottom: 20rpx;
  box-sizing: border-box;
}

.category-bar {
  display: flex;
  white-space: nowrap;
  background: #ffff99;
  padding: 16rpx 12rpx;
  border-bottom: 1rpx solid #e6dfc9;
  position: sticky;
  top: 0;
  z-index: 2;
}

.category-item {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: #5c5544;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.6);
}

.category-item.active {
  background: #2f7b27;
  color: #fff;
}

.list {
  padding: 12rpx 20rpx;
}

.list_item {
  display: flex;
  margin-top: 18rpx;
  padding: 18rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.list_item .img {
  width: 210rpx;
  height: 210rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #eee;
}

.list_item .img image {
  width: 100%;
  height: 100%;
}

.list_item .info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.list_item .info .title {
  font-size: 32rpx;
  color: #2b2b2b;
  font-weight: 600;
}

.list_item .info .price {
  margin-top: 10rpx;
  color: #e53935;
  font-size: 30rpx;
}

.list_item .info .descr {
  margin-top: 10rpx;
  color: #777;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.list_item .info .meta {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  color: #999;
  font-size: 22rpx;
}

.state {
  padding: 40rpx 0;
  text-align: center;
  color: #999;
  font-size: 26rpx;
}

.retry {
  margin-top: 16rpx;
  background: #2f7b27;
  color: #fff;
}
