<view class="container">
  <view class="wrapper">
    <view class="left-top-sign">LOGIN</view>
    <view class="welcome">
      欢迎回来！
    </view>
    <view class="input-content">
      <view class="input-item">
        <text class="tit">手机号码</text>
        <input type="number" maxlength="11" placeholder="请输入手机号码" id="phone" bindinput="handleInput"/>
      </view>
      <view class="input-item">
        <text class="tit">密码</text>
        <input type="password" placeholder="请输入密码" id="password" bindinput="handleInput"/>
      </view>
    </view>
    <button class="confirm-btn" bindtap="login" loading="{{submitting}}" disabled="{{submitting}}">登录</button>
    <view class="forget-section">演示账号：13900000000 / demo123</view>
  </view>
  <view class="register-section">
    还没有账号?
    <text bindtap="toRegister">马上注册</text>
  </view>
</view>
